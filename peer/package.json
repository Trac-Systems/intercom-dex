{
  "name": "intercom-dex-peer",
  "version": "0.1.61",
  "private": true,
  "type": "module",
  "pear": {
    "name": "intercom-dex",
    "type": "terminal"
  },
  "dependencies": {
    "b4a": "1.8.1",
    "bare-ws": "2.0.3",
    "compact-encoding": "2.18.0",
    "crypto": "npm:bare-node-crypto@1.0.0",
    "fs": "npm:bare-node-fs@1.0.2",
    "path": "npm:bare-node-path@1.0.1",
    "pear-runtime": "1.3.1",
    "protomux": "3.10.1",
    "hyperschema": "1.17.1",
    "trac-msb": "github:Trac-Systems/main_settlement_bus#a8226b4ddfd5fab4643aadd02dee9f09b5355509",
    "trac-peer": "github:Trac-Systems/trac-peer#6602492ba0d9ed75dc87da5126042148e21ce8aa",
    "trac-wallet": "1.0.1",
    "util": "npm:bare-node-util@1.0.0",
    "blind-relay": "1.6.1",
    "hyperdht": "6.29.6",
    "http": "npm:bare-node-http@1.0.1",
    "https": "npm:bare-node-https@1.0.0",
    "process": "npm:bare-node-process@1.0.1"
  },
  "overrides": {
    "blind-relay": "$blind-relay",
    "hyperdht": "$hyperdht",
    "trac-msb": "$trac-msb"
  },
  "scripts": {
    "start": "node scripts/pear-runner.mjs",
    "postinstall": "node scripts/apply-patches.mjs && node node_modules/trac-msb/scripts/hypercore-stallfix/apply.mjs && node node_modules/trac-peer/scripts/hypercore-stallfix/apply.mjs"
  },
  "main": "index.js"
}
